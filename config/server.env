# =============================================================================
# 部署服务器地址（当前生产/测试环境）
# =============================================================================

# 公网 IP — 安全组 / DNS 解析用
SERVER_PUBLIC_IP=39.106.134.222

# 对外 API（经 Nginx 443 反代，客户端与 PUBLIC_API_BASE_URL 均用此地址）
API_PUBLIC_URL=https://api.lcxxingyu.fun
API_BASE_URL=https://api.lcxxingyu.fun

# 私有 IP — 同一 VPC / 内网其他机器直连 uvicorn 时用
SERVER_PRIVATE_IP=172.25.19.38
API_PRIVATE_URL=http://172.25.19.38:8000

# 后端监听（服务器本机，勿改）
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# PostgreSQL 仅本机访问，不对外开放
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# 后端 .env 中需设置（语音 ASR 公网拉取录音）：
# PUBLIC_API_BASE_URL=https://api.lcxxingyu.fun
