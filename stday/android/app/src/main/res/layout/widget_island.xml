<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_island_background"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/review_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_review_title"
        android:textColor="#1A476B"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="工作岛屿今日回顾" />

    <!-- 岛屿切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_prev"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#5A85A8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/island_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/island_building_thumb"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/island_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#5A85A8"
                android:textSize="10sp"
                tools:text="🏝 工作岛屿" />

            <TextView
                android:id="@+id/island_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:text="活跃" />
        </LinearLayout>

        <TextView
            android:id="@+id/moment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#3A80A3"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="今日未记录" />

        <TextView
            android:id="@+id/island_level_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_level_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textColor="#1A5A96"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Lv.3" />

        <TextView
            android:id="@+id/island_next"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#5A85A8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/review_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:text="@string/widget_island_empty_review"
            android:textColor="#264F73"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/focus_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7A96AD"
            android:textSize="10sp"
            tools:text="工作岛屿 · 今日 1 条 · Lv.2" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_quick_record_button"
        android:gravity="center"
        android:minHeight="28dp"
        android:paddingVertical="5dp"
        android:text="@string/widget_island_quick_record"
        android:textColor="#1A5A96"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
