<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_island_background"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header: 今日待办 + 环形进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_todo_title"
            android:textColor="#1A476B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/progress_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_todo_title"
                android:scaleType="fitCenter"
                tools:src="@drawable/widget_task_check_todo" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#1A5A96"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="1/3" />
        </FrameLayout>
    </LinearLayout>

    <!-- 岛屿切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_prev"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#5A85A8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/island_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/island_building_thumb"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/island_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#5A85A8"
                android:textSize="10sp"
                tools:text="🏝 工作岛屿" />

            <TextView
                android:id="@+id/island_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:text="活跃" />
        </LinearLayout>

        <TextView
            android:id="@+id/island_level_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_level_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textColor="#1A5A96"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Lv.3" />

        <TextView
            android:id="@+id/island_next"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#5A85A8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 待办区：占满中间空间，按钮固定在底部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/task1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="14dp"
                android:layout_height="14dp">

                <ImageView
                    android:id="@+id/task1_check_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_todo" />

                <ImageView
                    android:id="@+id/task1_check_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_mark"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/task1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#264F73"
                android:textSize="11sp"
                tools:text="回复工作消息" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/task2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="14dp"
                android:layout_height="14dp">

                <ImageView
                    android:id="@+id/task2_check_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_todo" />

                <ImageView
                    android:id="@+id/task2_check_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_mark"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/task2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A96AD"
                android:textSize="11sp"
                tools:text="预约牙医" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/task3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="14dp"
                android:layout_height="14dp">

                <ImageView
                    android:id="@+id/task3_check_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_todo" />

                <ImageView
                    android:id="@+id/task3_check_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_task_check_mark"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/task3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A96AD"
                android:textSize="11sp"
                tools:text="整理桌面" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_island_empty_tasks"
            android:textColor="#7A96AD"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/task_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_quick_record_button"
        android:gravity="center"
        android:minHeight="28dp"
        android:paddingVertical="5dp"
        android:text="@string/widget_island_quick_record"
        android:textColor="#1A5A96"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
